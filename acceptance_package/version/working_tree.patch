+  const registrations = useFinanceQuery(`/employees/${employeeId}/statutory-registrations`, z.array(registration), true, Boolean(employeeId));
+  const coverages = useFinanceQuery(`/employees/${employeeId}/statutory-coverage`, z.array(coverage), true, Boolean(employeeId));
+  async function register() { const result = await action.run(`/employees/${employeeId}/statutory-registrations`, { scheme, registrationNumber: number, registeredAt, reason }, 'POST', registration); if (result) void registrations.refetch(); }
+  async function saveCoverage() { const result = await action.run(`/employees/${employeeId}/statutory-coverage`, { effectiveFrom: start, effectiveToExclusive: end || null, schemes: selectedSchemes, evidenceReference: evidence, evidenceSha256: sha, reason }, 'POST', coverage); if (result) void coverages.refetch(); }
+  async function approve(id: string, expectedVersion: string) { const result = await action.run(`/statutory-coverage/${id}/approve`, { expectedVersion, reason }, 'POST', coverage); if (result) void coverages.refetch(); }
+  return <section className="payroll-section-card"><h2>Employee registration and applicability</h2><PayrollEmployeePicker value={employeeId} onChange={setEmployeeId} /><TextAreaField label="Reason" required value={reason} onChange={setReason} />{employeeId && <><FinanceQueryState query={registrations}>{registrations.data?.map(row => <p key={row.id}>{row.scheme} · {row.registrationNumber} · {row.registeredAt}</p>)}</FinanceQueryState><form onSubmit={event => { event.preventDefault(); void register(); }}><fieldset disabled={action.pending}><PayrollSelect label="Scheme" value={scheme} onChange={setScheme} options={schemes} /><TextInput label="Registration number" required value={number} onChange={event => setNumber(event.target.value)} /><TextInput label="Registered on" type="date" required value={registeredAt} onChange={event => setRegisteredAt(event.target.value)} /><Button type="submit" disabled={!reason.trim()}>Record registration</Button></fieldset></form><FinanceQueryState query={coverages}><h3>Applicability decisions</h3>{coverages.data?.map(row => <article key={row.id} className="payroll-batch-card"><p>{row.effectiveFrom} → {row.effectiveToExclusive ?? 'Ongoing'} · {row.schemes.length ? row.schemes.join(', ') : 'Explicitly no applicable scheme'} · {row.state}</p><p>{row.evidenceReference}</p>{row.state === 'Draft' && access.can('statutory.contributions.approve') && <Button disabled={action.pending || !reason.trim()} onClick={() => void approve(row.id, row.version)}>Approve applicability</Button>}</article>)}</FinanceQueryState><form onSubmit={event => { event.preventDefault(); void saveCoverage(); }}><h3>Propose applicability</h3><fieldset disabled={action.pending}><TextInput label="Effective from" type="date" required value={start} onChange={event => setStart(event.target.value)} /><TextInput label="Effective end (exclusive)" type="date" value={end} onChange={event => setEnd(event.target.value)} />{schemes.map(item => <label key={item.value}><input type="checkbox" checked={selectedSchemes.includes(item.value)} onChange={event => setSchemes(values => event.target.checked ? [...values, item.value] : values.filter(value => value !== item.value))} /> {item.label}</label>)}<label><input type="checkbox" required checked={explicitCoverage} onChange={event => setExplicitCoverage(event.target.checked)} /> I have explicitly checked applicability, including any no-scheme decision.</label><TextInput label="Evidence reference" required value={evidence} onChange={event => setEvidence(event.target.value)} /><TextInput label="Evidence SHA256" required pattern="[a-fA-F0-9]{64}" value={sha} onChange={event => setSha(event.target.value)} /><Button type="submit" disabled={!reason.trim() || !explicitCoverage}>Submit applicability for approval</Button></fieldset></form></>}<ActionMessage action={action} /></section>;
 }
