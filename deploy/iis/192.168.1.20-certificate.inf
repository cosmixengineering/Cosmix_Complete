; Run certreq on the IIS SERVER, so the private key stays there.
; This creates a certificate REQUEST, not a trusted certificate.
[Version]
Signature="$Windows NT$"

[NewRequest]
Subject = "CN=192.168.1.20"
KeyLength = 3072
KeyAlgorithm = RSA
HashAlgorithm = sha256
MachineKeySet = TRUE
Exportable = FALSE
ProviderName = "Microsoft Software Key Storage Provider"
RequestType = PKCS10
KeyUsage = 0xa0

[Extensions]
2.5.29.17 = "{text}"
_continue_ = "IPAddress=192.168.1.20"
2.5.29.37 = "{text}1.3.6.1.5.5.7.3.1"
