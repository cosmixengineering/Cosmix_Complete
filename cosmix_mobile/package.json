    "@react-navigation/native-stack": "7.21.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "0.25.1",
    "react-native-get-random-values": "2.0.0",
    "react-native-image-picker": "8.3.0",
